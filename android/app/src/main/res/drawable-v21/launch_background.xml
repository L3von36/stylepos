<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen (API 21+): white + brand logo centred,
     forced light even when the OS is in dark mode (?android:colorBackground
     used to resolve to BLACK under the night theme — the "dark splash"). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/sami_launch_logo" />
    </item>
</layer-list>
