<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen: always light + brand logo centred.
     Dark mode NEVER darkens the splash — it is a brand moment
     (the in-app Flutter splash that follows is light too, so the
     hand-off is seamless; dark surfaces start one fade later). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/sami_launch_logo" />
    </item>
</layer-list>
