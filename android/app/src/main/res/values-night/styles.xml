<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting.
         FORCED LIGHT even when the OS Dark Mode setting is on: the splash
         is a brand moment (white + logo), matching the light in-app splash
         that follows. Was Theme.Black.NoTitleBar — that was the dark
         splash users saw on phones with dark mode enabled. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         The window background is white in BOTH modes so there is never a dark
         flash between the native launch screen and the light Flutter splash;
         dark surfaces fade in afterwards inside Flutter itself. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
